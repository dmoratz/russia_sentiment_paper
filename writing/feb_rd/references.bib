@article{fuhrmann_signaling_2014,
	title = {Signaling {Alliance} {Commitments}: {Hand}‐{Tying} and {Sunk} {Costs} in {Extended} {Nuclear} {Deterrence}},
	volume = {58},
	issn = {0092-5853, 1540-5907},
	shorttitle = {Signaling {Alliance} {Commitments}},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/ajps.12082},
	doi = {10.1111/ajps.12082},
	abstract = {How can states signal their alliance commitments? Although scholars have developed sophisticated theoretical models of costly signaling in international relations, we know little about which specific policies leaders can implement to signal their commitments. This article addresses this question with respect to the extended deterrent effects of nuclear weapons. Can nuclear states deter attacks against their friends by simply announcing their defense commitments? Or must they deploy nuclear weapons on a protégé's territory before an alliance is seen as credible? Using a new dataset on foreign nuclear deployments from 1950 to 2000, our analysis reveals two main findings. First, formal alliances with nuclear states appear to carry significant deterrence benefits. Second, however, stationing nuclear weapons on a protégé's territory does not bolster these effects. The analysis yields new insights about the dynamics of “hand‐tying” and “sunk cost” signals in international politics.},
	language = {en},
	number = {4},
	urldate = {2024-04-30},
	journal = {American Journal of Political Science},
	author = {Fuhrmann, Matthew and Sechser, Todd S.},
	month = oct,
	year = {2014},
	pages = {919--935},
}

@article{fearon_signaling_1997,
	title = {Signaling {Foreign} {Policy} {Interests}: {Tying} {Hands} versus {Sinking} {Costs}},
	volume = {41},
	issn = {0022-0027},
	shorttitle = {Signaling {Foreign} {Policy} {Interests}},
	url = {https://www.jstor.org/stable/174487},
	abstract = {The author distinguishes between two types of costly signals that state leaders might employ in trying to credibly communicate their foreign policy interests to other states, whether in the realm of grand strategy or crisis diplomacy. Leaders might either (a) tie hands by creating audience costs that they will suffer ex post if they do not follow through on their threat or commitment (i.e., costs arising from the actions of domestic political audiences) or (b) sink costs by taking actions such as mobilizing troops that are financially costly ex ante. Analysis of a game model depicting the essentials of each case yields two principal results. First, in the games' equilibria, leaders never bluff with either type of signal; they do not incur or create costs and then fail to respond if challenged. Second, leaders do better on average by tying hands, despite the fact that the ability to do so creates a greater ex ante risk of war than does the use of sunk-cost signals. These results and the logic behind them may help explain some empirical features of international signaling, such as many crises' appearance as competitions in creating domestic political audience costs. They also generate empirical puzzles, such as why the seemingly plausible logic of inference that undermines bluffing in the model does not operate in all empirical cases.},
	number = {1},
	urldate = {2024-04-30},
	journal = {The Journal of Conflict Resolution},
	author = {Fearon, James D.},
	year = {1997},
	pages = {68--90},
}

