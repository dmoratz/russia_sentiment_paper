@incollection{bjola_digital_2024,
	edition = {1},
	title = {Digital {Diplomacy} {During} {Wars} and {Conflicts}},
	isbn = {978-0-19-285919-8 978-0-19-194971-5},
	url = {https://academic.oup.com/edited-volume/55819/chapter/436591259},
	doi = {10.1093/oxfordhb/9780192859198.013.34},
	abstract = {Abstract
            The proliferation of digital communication platforms, particularly social media, has brought about both opportunities and challenges for the field of diplomacy and public diplomacy. The utilization of digital diplomacy in times of conflict and war has become particularly salient, as the image component has assumed a vital role in contemporary conflicts. This chapter explores the use of digital platforms as a component of the ‘Image War’ and how official diplomatic efforts employ various platforms and messaging strategies to shape perceptions and influence different audiences. It traces the evolution of digital diplomacy, from the American response to the 9/11 attacks to more recent examples such as the Israeli-Palestinian conflict on TikTok and the Ukrainian Image Front in the 2022 Russian Invasion of Ukraine. The chapter also examines civic initiatives, both organized and unstructured, that operate within the digital sphere and social media, enabling individuals to participate in civic diplomacy. The messages propagated by both governments and individuals increasingly constitute a part of the battle over perceptions in the international arena.},
	language = {en},
	urldate = {2025-12-01},
	booktitle = {The {Oxford} {Handbook} of {Digital} {Diplomacy}},
	publisher = {Oxford University Press},
	author = {Yarchi, Moran},
	editor = {Bjola, Corneliu and Manor, Ilan},
	month = jan,
	year = {2024},
	pages = {619--636},
}

@incollection{bjola_digital_2024-1,
	edition = {1},
	title = {Digital {Diplomacy} of the {Central} {Asian} {Countries}},
	isbn = {978-0-19-285919-8 978-0-19-194971-5},
	url = {https://academic.oup.com/edited-volume/55819/chapter/436590058},
	doi = {10.1093/oxfordhb/9780192859198.013.27},
	abstract = {Abstract
            This chapter analyses the features, trends, and challenges of digital diplomacy (DD) in the Central Asian countries (CAC) and focuses on social media diplomacy (SMD). The coronavirus pandemic has significantly affected the penetration of digital communication technologies into the diplomatic activities of CAC, including their consular work. The number of followers of the social accounts of presidents, foreign ministries, diplomatic missions abroad, and diplomats is constantly growing. But despite certain development of DD in the countries of the region, SMD has not yet become one of the main and proactive instruments of international diplomacy of these states. Using the ideas of game theory, the chapter argues that CAC have begun to develop their SMD and at this stage it takes place mostly through the dissemination of information about ongoing meetings and events, rather than engagement with other state and non-state actors regarding their long-term fundamental objectives and critical international problems. Currently, the SMD of CAC is largely based on reputation-building and image-making public diplomacy. For SMD to be used at a more strategic level, that is, as a pivotal instrument of foreign policy and diplomacy, CAC need to develop comprehensive strategies of dialogical engagement and interaction with other state and non-state stakeholders as well as a more conceptualized SMD with clearly defined strategic goals and measurable objectives.},
	language = {en},
	urldate = {2025-12-01},
	booktitle = {The {Oxford} {Handbook} of {Digital} {Diplomacy}},
	publisher = {Oxford University Press},
	author = {Faizullaev, Alisher},
	editor = {Bjola, Corneliu and Manor, Ilan},
	month = jan,
	year = {2024},
	pages = {491--510},
}

@misc{bansak_effect_2022,
	title = {Effect {Heterogeneity} and the {Challenges} of {Causal} {Attribution} in {Regression} {Discontinuity} {Designs}},
	copyright = {https://creativecommons.org/licenses/by/4.0/legalcode},
	url = {https://osf.io/vj34m},
	doi = {10.31235/osf.io/vj34m},
	abstract = {Research investigating subgroup differences in treatment effects recovered using regression discontinuity (RD) designs has become increasingly popular. For instance, scholars have investigated whether incumbency effects on candidate persistence or winning again vary by candidate characteristics or local context. Under what conditions can we interpret subgroup differences in treatment effects as a causal result of the moderating characteristic? In this study, we explore the difference between RD effect conditionality that is simply associated with versus causally driven by another variable. To make this distinction explicit and formal, we define two alternative estimands, and we lay out identification assumptions required for each estimand along with corresponding estimation procedures. In doing so, we demonstrate how investigating RD effect conditionality that is causally driven by another variable involves several serious challenges related to interpretation, identification, and estimation. Accordingly, we urge caution and offer practical advice for applied researchers considering these alternative quantities of interest. To illustrate, we include applications to several recent studies.},
	urldate = {2025-11-24},
	publisher = {SocArXiv},
	author = {Bansak, Kirk and Nowacki, Tobias},
	month = jun,
	year = {2022},
}

