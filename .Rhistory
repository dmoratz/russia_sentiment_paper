# Create a factor variable for the running variable
optimal_data_event <- optimal_bandwidth_data %>%
mutate(
event_time_factor = factor(running)
)
# Run the regression
es_model <- feols(sentiment_clean ~ i(state_owned, event_time_factor) | source_domain + topic_clean + country,
data = optimal_data_event,
vcov = cluster~source_domain)
summary(es_model)
plot_es <- iplot(
es_model,
main = "Event Study Plot (Test for Parallel Trends)",
xlab = "Periods Relative to Treatment (Days/Months/Years)",
ylab = "Effect on Sentiment (Coefficients $\\gamma_k$)",
# Adjust horizontal line at y=0
ref.line = 0,
# Adjust vertical line at treatment onset (t=0)
ref.point = -0.5,
col = c("blue", "red"), # Custom colors for pre/post treatment periods
lwd = 1.5
)
