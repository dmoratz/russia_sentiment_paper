geom_smooth(method="lm") +
scale_color_manual(values=c("dodgerblue","forestgreen", "red4","darkorange"), name = "Source Type") +
scale_size(name = "Observations") +
geom_vline(xintercept=0, linetype="dashed", alpha=.7) +
theme_classic() +
labs(title = "Figure 4 Optimal: Effect of Invasion on Sentiment",
subtitle = "Difference in Discontinuities",
x = "Days Pre/Post Invasion",
y = "Sentiment")
