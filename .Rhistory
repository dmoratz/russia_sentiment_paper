rows <- tibble::tribble(~row1, ~row2, ~row3, ~row4, ~row5, ~row6,
'State FEs', 'X', 'X', 'X', 'X', 'X',
'Source FEs', 'X', 'X', 'X', 'X', 'X',
'Topic FEs', 'X', 'X', 'X', 'X', 'X')
attr(rows, 'position') <- c(5,6,7)
# note text
note_text <- "All standard errors are clustered at the source level. Model 2 uses the triangular kernel within the optimal bandwidth. Model 3 omits NATO allies. Model 4 omits military-related articles.  Model 5 omits military-related articles and only uses articles that were classified as primarily Russian Related."
# Wrap note into 80-character lines
note_wrapped <- str_wrap(note_text, width = 80)
table_2 <- modelsummary(list(model2a, model2a_opt, model2d, model2b, model3a),
output ="gt",
fmt = fmt_significant(2),
stars = TRUE,
coef_map = c("treatment" = "Invasion",
"treatment:state_owned" = "State Owned x Treatment"),
gof_omit = "BIC|AIC|RMSE|Std.Errors",
title = "Difference in Discontinuity Analysis",
add_rows = rows,
notes = note_wrapped
)
table_2
